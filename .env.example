# Google Gemini — used for Part 1 (classify/describe) and Part 2 (reasoning + image edit)
GEMINI_API_KEY=

# Optional — if using Vertex / Google Cloud project
GOOGLE_CLOUD_PROJECT=

# Part 1 — vision + JSON (cheap)
GEMINI_MODEL=gemini-2.5-flash-lite

# Part 2 — styling / edit instruction
GEMINI_REASONING_MODEL=gemini-2.5-flash-lite

# Part 2 — image customisation (Banana / native image gen)
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
