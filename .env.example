# Google Gemini — used for Part 1 (classify/describe) and Part 2 (reasoning + image edit)
GEMINI_API_KEY=

# Optional — if using Vertex / Google Cloud project
GOOGLE_CLOUD_PROJECT=

# Part 1 — vision + JSON
GEMINI_MODEL=gemini-3.5-flash

# Part 2 — styling / edit instruction
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite

# Part 2 — image edit (Nano Banana 2 — NOT the old 2.0 preview model)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
